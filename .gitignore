# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local credentials — never commit
SUPABASE-STUDIO-CREDENTIALS.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Screenshots captured by the in-app browser while verifying UI work. Build
# artefacts of the process, not source — and binary files age badly in history.
.openchamber/

# Local brainstorming state (ports, tokens, scratch mockups) — never commit.
.superpowers/
